   },
   "source": [
    "for _ in range(2):\n",
    "\n",
    "    for pos in range(length):\n",
    "        line = [\"_\"] * length\n",
    "        line[pos] = \"*\"\n",
    "        print(\"\".join(line))\n",
    "\n",
    "    for pos in range(length - 1, -1, -1):\n",
    "        line = [\"_\"] * length\n",
    "        line[pos] = \"*\"\n",
    "        print(\"\".join(line))"
